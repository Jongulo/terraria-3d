; Engine configuration file.
config_version=5

[application]

config/name="Terraria 3D"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Settings="*res://scripts/autoload/settings.gd"
Controls="*res://scripts/autoload/controls.gd"
Assets="*res://scripts/autoload/assets.gd"
Data="*res://scripts/autoload/data.gd"
Audio="*res://scripts/autoload/audio.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[physics]

common/physics_ticks_per_second=60

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/default_filters/anisotropic_filtering_level=0
anti_aliasing/quality/msaa_3d=0

[shader_globals]

player_light_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
player_light_color={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
underworld_top={
"type": "float",
"value": -100000.0
}
hell_light={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
sun_shadows={
"type": "bool",
"value": false
}
gi_on={
"type": "bool",
"value": false
}
sun_shade={
"type": "float",
"value": 0.5
}
sun_dir={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
